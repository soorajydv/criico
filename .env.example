# MongoDB Atlas connection string. Replace the placeholders with your Atlas
# database user, password, cluster host, and database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/criico?retryWrites=true&w=majority

# Secret used to sign session JWTs (HS256). At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-48-plus-chars
