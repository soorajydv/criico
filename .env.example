# MongoDB connection string for your existing database.
MONGODB_URI=mongodb://localhost:27017/criico

# Secret used to sign session JWTs (HS256). At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-48-plus-chars
